# Database Configuration
# WARNING: These are PLACEHOLDER values. Copy to .env (gitignored) and set
# real secrets there. Never commit real credentials to .env.example.
DB_NAME=nvwax
DB_USER=nvwax
DB_PASSWORD=change_me_strong_password
DB_PORT=5432

# Backend Configuration
BACKEND_PORT=3001
# JWT_SECRET: 【必需】JWT签名密钥，必须是足够长的随机字符串（建议32字符以上）
JWT_SECRET=your-secure-jwt-secret-key-change-in-production
# CROSS_AUTH_SECRET: 【必需】与ProClaw跨服务认证的共享密钥
CROSS_AUTH_SECRET=your-secure-cross-auth-secret-change-in-production
# ADMIN_JWT_SECRET: 【可选】如果设置，将用于Admin专属JWT签名（优先级高于JWT_SECRET）
# ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production
REDIS_URL=redis://redis:6379

# Frontend Configuration
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://nvwax.proclaw.cc/api
# 前端URL：用于CORS白名单
FRONTEND_URL=https://nvwax.proclaw.cc
# CORS白名单：从环境变量添加更多允许的来源（逗号分隔）
# CORS_ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Redis Configuration
REDIS_PORT=6379

# AI Model Configuration (Choose one)
# Option 1: DeepSeek API (Recommended)
# Get key at https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# Option 2: OpenAI API (Alternative)
# OPENAI_API_KEY=your_openai_api_key_here

# Reviewer Agent Configuration
REVIEWER_MODEL=gpt-4
REVIEWER_TEMPERATURE=0.2
REVIEWER_TIMEOUT=30000

# Parallel Search Configuration
PARALLEL_SEARCH_TIMEOUT=30000
MAX_PARALLEL_TASKS=10

# Workflow API Configuration
WORKFLOW_API_URL=http://localhost:3002/api

# Optional: SSL Certificates (for production)
# SSL_CERTIFICATE=/etc/nginx/ssl/cert.pem
# SSL_CERTIFICATE_KEY=/etc/nginx/ssl/key.pem

# ========== Social Login Configuration ==========

# Stripe Configuration (Token 购买 - 海外支付)
# 注册 Stripe: https://dashboard.stripe.com/register
# 获取密钥: https://dashboard.stripe.com/apikeys
# 设置 Webhook: https://dashboard.stripe.com/webhooks
# STRIPE_SECRET_KEY=[在此填写你的Stripe Secret Key]
# STRIPE_WEBHOOK_SECRET=[在此填写你的Stripe Webhook Secret]
# STRIPE_WEBHOOK_BASE_URL=https://nvwax.proclaw.cc

# Facebook OAuth (创建 Facebook Developer App 后获取)
# 1. 前往 https://developers.facebook.com 创建 App
# 2. 在 App Dashboard -> Settings -> Basic 获取 App ID 和 App Secret
# 3. 在 Products -> Facebook Login -> Settings 中添加 OAuth redirect URI
# 4. 前端需要: NEXT_PUBLIC_FACEBOOK_APP_ID
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
# NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# Google OAuth (创建 Google Cloud Console 项目后获取)
# 1. 前往 https://console.cloud.google.com 创建项目
# 2. API和服务 -> 凭据 -> 创建 OAuth 2.0 客户端 ID (Web 应用类型)
# 3. 在"授权的 JavaScript 来源"添加前端 URL
# 4. 获取 Client ID 填入以下变量
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GitHub OAuth (创建 GitHub OAuth App 后获取)
# 1. 前往 https://github.com/settings/developers 创建 OAuth App
# 2. 填写 Homepage URL 和 Authorization callback URL
# 3. 生成 Client secret
# 4. 获取 Client ID 和 Client Secret 填入以下变量
# 注意：Authorization callback URL 必须与代码中使用的回调地址一致
#   - 开发环境：http://localhost:3000/api/auth/github/callback
#   - 生产环境：https://your-domain.com/api/auth/github/callback
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxxxxxx

# ========== OIDC IdP Configuration (Sprint 1) ==========
# OIDC issuer URL（与 ProClaw MULTI_PROJECT_INTEGRATION_SPEC.md 4.3 节一致）
# 开发环境可改为 http://account.proclaw.cc
OIDC_ISSUER=https://account.proclaw.cc
# 私钥路径（PKCS8 PEM 格式）。缺失时开发环境自动生成临时密钥到 data/oidc-dev-keys/
# 生产环境必须设置，建议 K8s Secret 挂载到 /etc/oidc/keys/private.pem
# 同时在同目录放 public.pem（SPKI 格式）供 JWKS 公钥派生
# OIDC_PRIVATE_KEY_PATH=/etc/oidc/keys/private.pem

# ========== RP 侧 OIDC / SSO (Sprint 2.12, nvwax-web 前端) ==========
# 浏览器侧 OIDC 登录流程读取这些值，必须 NEXT_PUBLIC_ 前缀（构建期烤进 bundle）。
# 与 IdP oidc_clients 表注册的 client 保持一致。
#   dev:   NEXT_PUBLIC_OIDC_ISSUER=http://localhost:3001
#   prod:  NEXT_PUBLIC_OIDC_ISSUER=https://account.proclaw.cc
NEXT_PUBLIC_OIDC_ISSUER=http://localhost:3001
NEXT_PUBLIC_OIDC_CLIENT_ID=proclaw-web
# 回调地址必须与 oidc_clients.redirect_uris 中的一项完全一致
NEXT_PUBLIC_OIDC_REDIRECT_URI=http://localhost:3000/oauth/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:3000
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OIDC_ADMIN_CLIENT_ID=nvwax-admin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 前端 session cookie 加密密钥（服务端 API Route 使用，运行期注入；dev 可用随机值）
# 生成方法：openssl rand -base64 32
OIDC_SESSION_SECRET=change-me-openssl-rand-base64-32-bytes

# ========== ProClaw account portal (Sprint 2) ==========
# pc_session cookie signing key. 32+ random bytes recommended.
# Generate with: openssl rand -hex 32
# Sprint 2 stores no PII in the cookie; rotation invalidates all sessions.
PC_SESSION_SECRET=replace-me-with-openssl-rand-hex-32

# Cookie scope (cross-subdomain SSO). Default: .proclaw.cc
PC_SESSION_COOKIE_DOMAIN=.proclaw.cc

# Mail delivery. In dev/test, leave SMTP_HOST=localhost and run MailPit
# (docker compose up mailpit) on port 1025 (SMTP) / 8025 (UI).
# In production, point to AWS SES:
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=AKIA...   (provided by ProClaw SRE)
#   SMTP_PASS=...       (provided by ProClaw SRE)
#   SMTP_FROM="ProClaw 团队 <noreply@account.proclaw.cc>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="ProClaw 团队 <noreply@account.proclaw.cc>"
# SMTP_USER=
# SMTP_PASS=

# ==================== Phase 3: 隔离执行 worker (nvwax-executor) ====================
# 委托执行任务给独立的 nvwax-executor 进程（默认 http://localhost:3010）
# EXECUTOR_URL=http://localhost:3010
# EXECUTOR_TOKEN=<与 nvwax-executor 的 EXECUTOR_TOKEN 一致>（未配置时执行委托路由返回 503 fail-closed）
LLM_DEFAULT_MODEL=deepseek-v4-flash
