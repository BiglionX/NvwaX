# ========================================
# NvwaX 生产环境环境变量配置示例
# ========================================
# 
# 使用方法：
#   1. 复制此文件为 .env（后端）或 .env.production（前端）
#   2. 将所有 "your-xxx" 替换为真实值
#   3. 不要将此文件提交到代码仓库
#
# ========================================

# ===== 数据库配置 =====
# 生产环境必须使用真实的数据库凭证
DB_NAME=nvwax
DB_USER=nvwax
DB_PASSWORD=your-secure-database-password
DB_PORT=5432

# 数据库连接 URL（完整格式）
# postgresql://username:password@host:port/database?sslmode=disable
DATABASE_URL=postgresql://nvwax:your-secure-database-password@localhost:5432/nvwax?sslmode=disable

# ===== 后端配置 =====
# JWT Secret（必须修改！建议 32 字符以上随机字符串）
# 生成方法：openssl rand -hex 32
JWT_SECRET=your-super-secure-jwt-secret-key-change-in-production

# Cross Auth Secret（用于 ProClaw 跨服务认证）
CROSS_AUTH_SECRET=your-cross-auth-secret-change-in-production

# Admin JWT Secret（可选，如果设置则优先于 JWT_SECRET）
# ADMIN_JWT_SECRET=your-admin-jwt-secret-change-in-production

# 后端端口
BACKEND_PORT=3001

# Redis URL
REDIS_URL=redis://redis:6379

# ===== 前端配置 =====
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=https://your-domain.com/api
FRONTEND_URL=https://your-domain.com

# ===== RP 侧 OIDC / SSO 配置（Sprint 2.12，前端构建必需）=====
# 浏览器侧 OIDC 登录流程读取这些值，必须 NEXT_PUBLIC_ 前缀并在构建期注入。
# 与 IdP（account.proclaw.cc / nvwax-server oidc_clients 表）注册的 client 保持一致。
NEXT_PUBLIC_OIDC_ISSUER=https://account.proclaw.cc
NEXT_PUBLIC_OIDC_CLIENT_ID=proclaw-web
# 回调地址必须与 oidc_clients.redirect_uris 中的一项完全一致
NEXT_PUBLIC_OIDC_REDIRECT_URI=https://your-domain.com/oauth/callback
NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=https://your-domain.com
NEXT_PUBLIC_OIDC_SCOPE=openid profile email
NEXT_PUBLIC_OIDC_ADMIN_CLIENT_ID=nvwax-admin
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ===== 前端 session cookie 加密密钥（服务端 API Route 使用，运行期注入）=====
# 生成方法：openssl rand -base64 32
# ⚠️ 前端生产部署必须设置，否则 OIDC 登录回调写 cookie 会失败。
OIDC_SESSION_SECRET=your-oidc-session-secret-32-bytes-base64

# CORS 白名单（逗号分隔）
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===== GitHub OAuth 配置 =====
# 创建 GitHub OAuth App: https://github.com/settings/developers
# 
# 重要：回调 URL 必须设置为：
#   https://your-domain.com/api/auth/github/callback
# 
# 获取方法：
#   1. 访问 https://github.com/settings/developers
#   2. 点击 "New OAuth App"
#   3. 填写应用信息
#   4. 复制 Client ID 和 Client Secret
#
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxxxxxxxxx

# ===== Google OAuth 配置 =====
# 创建 Google OAuth App: https://console.cloud.google.com/
# 
# 重要：必须在 "Authorized JavaScript origins" 中添加：
#   https://your-domain.com
# 
# 获取方法：
#   1. 访问 https://console.cloud.google.com/
#   2. 创建项目
#   3. 创建 OAuth 2.0 Client ID（Web 应用类型）
#   4. 复制 Client ID
#
GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ===== Facebook OAuth 配置（可选）=====
# 创建 Facebook App: https://developers.facebook.com/
# 
# FACEBOOK_APP_ID=your_facebook_app_id
# FACEBOOK_APP_SECRET=your_facebook_app_secret
# NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id

# ===== AI 模型配置 =====
# DeepSeek API（推荐）
# 获取密钥: https://platform.deepseek.com/api_keys
# 
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI API（备选）
# OPENAI_API_KEY=your_openai_api_key_here

# ===== 支付配置（可选）=====
# Stripe（海外支付）
# 注册: https://dashboard.stripe.com/register
# 获取密钥: https://dashboard.stripe.com/apikeys
# 
# STRIPE_SECRET_KEY=your_stripe_secret_key_here
# STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here

# ===== 邮件配置 =====
# SMTP 配置（用于发送验证邮件、通知等）
# 
# 开发环境（使用 MailPit）：
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
# 
# 生产环境（使用 AWS SES 或其他 SMTP 服务）：
#   SMTP_HOST=email-smtp.us-east-1.amazonaws.com
#   SMTP_PORT=587
#   SMTP_USER=AKIA...
#   SMTP_PASS=...
# 
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM="NvwaX Team <noreply@your-domain.com>"
# SMTP_USER=
# SMTP_PASS=

# ===== OIDC IdP 配置（Sprint 1）=====
# OIDC issuer URL
OIDC_ISSUER=https://account.proclaw.cc

# 私钥路径（PKCS8 PEM 格式）
# 生产环境必须设置，建议使用 K8s Secret 挂载
# 
# OIDC_PRIVATE_KEY_PATH=/etc/oidc/keys/private.pem

# ===== ProClaw Account Portal（Sprint 2）=====
# pc_session cookie signing key（32+ 随机字节）
# 生成方法：openssl rand -hex 32
PC_SESSION_SECRET=your-pc-session-secret-change-in-production

# Cookie 作用域（跨子域名 SSO）
PC_SESSION_COOKIE_DOMAIN=.your-domain.com

# ===== 日志配置 =====
LOG_LEVEL=info
# LOG_FILE=/var/log/nvwax/app.log

# ===== 其他配置 =====
# 环境
NODE_ENV=production

# 是否启用详细错误堆栈（生产环境建议 false）
SHOW_ERROR_STACK=false

# 请求超时（毫秒）
REQUEST_TIMEOUT=30000

# ========================================
# 安全提示：
# ========================================
# 
# 1. 不要将此文件提交到代码仓库
# 2. 生产环境必须使用强密码和密钥
# 3. 定期轮换密钥和 Secret
# 4. 使用 Docker Secrets 或 Kubernetes Secrets 管理敏感信息
# 5. 启用 HTTPS（SSL/TLS）
# 
# ========================================
# 配置检查清单：
# ========================================
# 
# 后端 (.env):
#   [ ] DATABASE_URL
#   [ ] JWT_SECRET
#   [ ] CROSS_AUTH_SECRET
#   [ ] GITHUB_CLIENT_ID
#   [ ] GITHUB_CLIENT_SECRET
#   [ ] GOOGLE_CLIENT_ID
#   [ ] PC_SESSION_SECRET
# 
# 前端 (.env.production):
#   [ ] NEXT_PUBLIC_API_URL
#   [ ] NEXT_PUBLIC_GITHUB_CLIENT_ID
#   [ ] NEXT_PUBLIC_GOOGLE_CLIENT_ID
# 
# ========================================

# ===== Phase 2/3: 编排与执行委托 =====
# WORKFLOW_API_URL=http://skillhub:3002/api
# EXECUTOR_URL=http://executor:3010
# EXECUTOR_TOKEN=change-me-shared-token
