# packages/nvwax-web/.env.production.example
# ──────────────────────────────────────────────────────────────
# NvwaX Web 前端 — 生产环境变量参考
# 用途：Vercel 部署时在项目后台配置环境变量
# 规则：此文件本身不提交 .env（已在根 .gitignore 排除 .env.production）
# ──────────────────────────────────────────────────────────────

# ── OIDC IdP（必填）────────────────────────────────────────────
# NvwaX OIDC Issuer，account.proclaw.cc 是正式 IdP
# SkillHub RP 必须指向此 issuer
NEXT_PUBLIC_OIDC_ISSUER=https://account.proclaw.cc

# ── API 地址（必填）────────────────────────────────────────────
# 前端 → 后端 API 请求地址（生产为 https://nvwax.proclaw.cc/api）
# 不要带尾部斜杠
NEXT_PUBLIC_API_URL=https://nvwax.proclaw.cc/api
