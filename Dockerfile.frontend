# Build stage for frontend
FROM node:20-alpine AS frontend-builder

WORKDIR /app

# 强制清除缓存标记
ARG CACHE_BUST=1

# Install pnpm
RUN npm install -g pnpm

# Copy monorepo package files
COPY package.json pnpm-workspace.yaml .npmrc ./
COPY packages/nvwax-web/package*.json ./packages/nvwax-web/
COPY packages/nvwax-sdk/package*.json ./packages/nvwax-sdk/

# Install dependencies (explicitly disable frozen-lockfile)
RUN pnpm install --no-frozen-lockfile

# Copy source code
COPY packages/nvwax-web/ ./packages/nvwax-web/
COPY packages/nvwax-sdk/ ./packages/nvwax-sdk/

# Build Next.js app
WORKDIR /app/packages/nvwax-web

# GitHub OAuth 环境变量
ARG NEXT_PUBLIC_API_URL=https://nvwax.proclaw.cc/api
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

ARG NEXT_PUBLIC_GITHUB_CLIENT_ID=
ENV NEXT_PUBLIC_GITHUB_CLIENT_ID=${NEXT_PUBLIC_GITHUB_CLIENT_ID}

ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ENV NEXT_PUBLIC_GOOGLE_CLIENT_ID=${NEXT_PUBLIC_GOOGLE_CLIENT_ID}

# OIDC / SSO 环境变量（浏览器侧需要，必须 NEXT_PUBLIC_ 前缀并在构建期烤进 bundle）
ARG NEXT_PUBLIC_OIDC_ISSUER=https://account.proclaw.cc
ENV NEXT_PUBLIC_OIDC_ISSUER=${NEXT_PUBLIC_OIDC_ISSUER}

ARG NEXT_PUBLIC_OIDC_CLIENT_ID=proclaw-web
ENV NEXT_PUBLIC_OIDC_CLIENT_ID=${NEXT_PUBLIC_OIDC_CLIENT_ID}

ARG NEXT_PUBLIC_OIDC_REDIRECT_URI=https://nvwax.proclaw.cc/oauth/callback
ENV NEXT_PUBLIC_OIDC_REDIRECT_URI=${NEXT_PUBLIC_OIDC_REDIRECT_URI}

ARG NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=https://nvwax.proclaw.cc
ENV NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=${NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI}

ARG NEXT_PUBLIC_OIDC_SCOPE="openid profile email"
ENV NEXT_PUBLIC_OIDC_SCOPE=${NEXT_PUBLIC_OIDC_SCOPE}

ARG NEXT_PUBLIC_OIDC_ADMIN_CLIENT_ID=nvwax-admin
ENV NEXT_PUBLIC_OIDC_ADMIN_CLIENT_ID=${NEXT_PUBLIC_OIDC_ADMIN_CLIENT_ID}

ARG NEXT_PUBLIC_SITE_URL=https://nvwax.proclaw.cc
ENV NEXT_PUBLIC_SITE_URL=${NEXT_PUBLIC_SITE_URL}

RUN pnpm build

# Production stage for frontend
FROM node:20-alpine AS frontend-production

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy monorepo package files
COPY package.json pnpm-workspace.yaml .npmrc ./
COPY packages/nvwax-web/package*.json ./packages/nvwax-web/

# Install dependencies (including TypeScript for Next.js runtime)
RUN pnpm install --no-frozen-lockfile

# Copy built files
COPY --from=frontend-builder /app/packages/nvwax-web/.next ./packages/nvwax-web/.next
COPY --from=frontend-builder /app/packages/nvwax-web/public ./packages/nvwax-web/public
COPY --from=frontend-builder /app/packages/nvwax-web/next.config.ts ./packages/nvwax-web/next.config.ts

# Create non-root user
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nvwax -u 1001

# Fix permissions for .next directory (nvwax user needs write access for image cache)
RUN chown -R nvwax:nodejs /app/packages/nvwax-web

USER nvwax

WORKDIR /app/packages/nvwax-web

EXPOSE 3000

ENV NODE_ENV=production
ENV PORT=3000

# OIDC 运行期配置（服务端路由读 process.env；docker-compose environment 会覆盖这些默认值）
# OIDC_SESSION_SECRET 是 session cookie 加密密钥，绝不能烤进镜像，必须运行期注入：
#   openssl rand -base64 32
ENV OIDC_SESSION_SECRET=
ENV NEXT_PUBLIC_OIDC_ISSUER=https://account.proclaw.cc
ENV NEXT_PUBLIC_OIDC_CLIENT_ID=proclaw-web
ENV NEXT_PUBLIC_OIDC_REDIRECT_URI=https://nvwax.proclaw.cc/oauth/callback
ENV NEXT_PUBLIC_OIDC_POST_LOGOUT_REDIRECT_URI=https://nvwax.proclaw.cc
ENV NEXT_PUBLIC_OIDC_SCOPE="openid profile email"
ENV NEXT_PUBLIC_OIDC_ADMIN_CLIENT_ID=nvwax-admin
ENV NEXT_PUBLIC_SITE_URL=https://nvwax.proclaw.cc

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:3000/api/health || exit 1

CMD ["pnpm", "start"]
