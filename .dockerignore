# Docker 相关
node_modules/
.next/
dist/
build/
*.log
out/

# 运行期产物 / 部署脚本（不能进构建上下文）
# 服务器 /opt/nvwax 内存在多个 root 所有权的构建产物目录
# （account-portal-out / portal-new / portal-out 等），
# Docker 遍历构建上下文时 lstat 会 permission denied，导致构建失败。
/portal*
/account-portal*
/backend-dist*
/*.zip
/create-test-client.sql
/test-results/
/deploy-*
/portal-deploy.sh
/portal-runner.sh

# 环境变量
.env
.env.local
.env.production
.env.development

# IDE
.vscode/
.idea/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db

# 测试覆盖率
coverage/
.nyc_output/

# 临时文件
tmp/
temp/
*.tmp

# Git
.git/
.gitignore

# 文档
*.md
!README.md
