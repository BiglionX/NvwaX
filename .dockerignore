dist/
build/
*.log
out/

# 运行期产物 / 部署脚本（不能进构建上下文）
# account-portal-out 是服务器上的静态导出目录（运行时挂载），
# 曾因 root 所有权导致 backend 构建上下文遍历时 permission denied
/account-portal-out
/portal-out*
/backend-dist*
/deploy-*
/portal-deploy.sh
/portal-runner.sh
/*.zip
/create-test-client.sql

